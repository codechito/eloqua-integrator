# Copy to .env and fill in. Loaded by dotenv in server.js.
# Unlike salesforce-integrator there is no startup validation here — a missing
# value fails later at connect/OAuth time instead, so check this list carefully.

# --- Server ---
PORT=3000
NODE_ENV=development
# Public base URL used to build AppCloud callback URLs sent to Eloqua.
# Falls back to https://eloqua-integrator.onrender.com if unset, which is
# almost certainly wrong for local work — set it.
APP_BASE_URL=http://localhost:3000
# Signs the express session cookie. Falls back to the literal 'eloqua-secret'
# if unset; set a real value.
SESSION_SECRET=

# --- MongoDB: required ---
MONGODB_URI=mongodb://localhost:27017/eloqua-integrator

# --- Eloqua OAuth: required ---
# From your Eloqua AppCloud app registration
ELOQUA_CLIENT_ID=
ELOQUA_CLIENT_SECRET=
# Base callback URL, WITHOUT a trailing slash and WITHOUT the installId —
# oauthService.js appends `/${installId}` to this value.
# Route is mounted at /eloqua/app (server.js) + /oauth/callback/:installId.
ELOQUA_REDIRECT_URI=http://localhost:3000/eloqua/app/oauth/callback

# --- SMS worker (npm run worker), optional, defaults shown ---
SMS_WORKER_BATCH_SIZE=10
SMS_WORKER_POLL_INTERVAL=5000
SMS_WORKER_CONCURRENCY=5

# --- Notifications: optional ---
# Leave blank to disable Slack notifications
SLACK_WEBHOOK_URL=
